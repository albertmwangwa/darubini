    { "id": "t-test", "x": 1984, "y": 200, "axis": "x", "items": [ { "id": "t-check", "kind": "button", "label": "Test connection", "icon": "wifi_tethering", "variant": "tonal", "size": 380, "note": "Calls /health and shows whether the server answered." } ] },
    { "id": "t-lang", "x": 1984, "y": 280, "axis": "x", "items": [ { "id": "t-language", "kind": "select", "label": "Report language", "icon": "translate", "variant": "outlined", "tabs": [ { "label": "English" }, { "label": "Kiswahili" } ], "selected": 0 } ] }
  ]
