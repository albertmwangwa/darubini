    { "id": "r-again", "x": 1492, "y": 960, "axis": "x", "items": [ { "id": "r-new", "kind": "button", "label": "Start another slide", "icon": "add", "variant": "filled", "size": 380, "action": { "to": "start", "transition": "fade" } } ] },
    { "id": "r-foot", "x": 1492, "y": 1040, "axis": "x", "items": [ { "id": "r-disc", "kind": "text", "label": "Decision support only. A qualified microscopist must confirm every result.", "icon": null, "variant": "filled", "size": 12 } ] },

    { "id": "t-bar", "x": 1968, "y": 0, "axis": "x", "items": [ { "id": "t-top", "kind": "topAppBar", "label": "Settings", "icon": "arrow_back", "variant": "filled", "actions": { "icon": { "to": "back", "transition": "slide" } } } ] },
