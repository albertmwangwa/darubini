# Copy to .env and fill in. Never commit .env.

# Meta Model API (key from https://dev.meta.ai; docs at https://dev.meta.ai/docs/)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SEGMENTATION_MODEL=sam-3.1
META_REASONING_MODEL=muse-spark-1.3
# Voice commands in the phone apps (Muse Voice Transcribe)
META_VOICE_MODEL=muse-voice-transcribe-1.0
META_TIMEOUT_S=60

# Optional: Muse Spark Open (open weights) on an OpenAI-compatible host, for
# `darubini analyse --narrate open`. Baseten: https://inference.baseten.co/v1;
# Fireworks: https://api.fireworks.ai/inference/v1 with
# OPEN_WEIGHTS_MODEL=accounts/fireworks/models/muse-spark-open; or a local vLLM server.
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open

# Pipeline: "baseline" or "verified" (offline, no API); "sam3", "hybrid" or "confirmed"
# (need the API; "confirmed" adds SAM 3.1 box confirmation of each parasite).
# "verified", "hybrid" and "confirmed" use the trained verifier shipped in models/parasite_verifier.npz
# (retrain with `darubini train-verifier`). Without an API key, use "verified" (the default).
DARUBINI_SEGMENTER=hybrid
# Report language: "en" or "sw"
DARUBINI_REPORT_LANGUAGE=en
DARUBINI_DATASETS_DIR=datasets
DARUBINI_VERIFIER_PATH=models/parasite_verifier.npz
# Cache of SAM replies, so a repeated image and prompt is never billed twice
DARUBINI_CACHE_DIR=.cache/meta
