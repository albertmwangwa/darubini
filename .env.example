# Copy to .env and fill in. Never commit .env.

# Meta Model API (credits arrive with hackathon acceptance; base URL and model ids from the kickoff docs)
META_API_KEY=
META_API_BASE_URL=
META_SEGMENTATION_MODEL=sam-3
META_REASONING_MODEL=muse-spark
META_TIMEOUT_S=60

# Pipeline: "baseline" (offline, no API) or "sam3"
DARUBINI_SEGMENTER=baseline
# Report language: "en" or "sw"
DARUBINI_REPORT_LANGUAGE=en
DARUBINI_DATASETS_DIR=datasets
