# Copy to .env and fill in. Never commit .env.

# Meta Model API (key from https://dev.meta.ai; docs at https://dev.meta.ai/docs/)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SEGMENTATION_MODEL=sam-3.1
META_REASONING_MODEL=muse-spark-1.3
META_TIMEOUT_S=60

# Pipeline: "baseline" or "verified" (offline, no API), "sam3" or "hybrid" (need the API).
# "verified" and "hybrid" need a trained verifier: `darubini train-verifier`.
DARUBINI_SEGMENTER=baseline
# Report language: "en" or "sw"
DARUBINI_REPORT_LANGUAGE=en
DARUBINI_DATASETS_DIR=datasets
DARUBINI_VERIFIER_PATH=models/parasite_verifier.npz
# Cache of SAM replies, so a repeated image and prompt is never billed twice
DARUBINI_CACHE_DIR=.cache/meta
